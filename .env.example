# Environment for the Rise Hytale server image. Copy to .env and fill in.
# Values shown are the entrypoint/Dockerfile defaults unless marked required.

# --- Required ---------------------------------------------------------------

# Comma-separated server types this node runs. The SERVER_TYPE_ prefix is
# optional and matching is case-insensitive, so HUB_PVP == SERVER_TYPE_HUB_PVP.
# Entries in index.json tagged SERVER_TYPE_UNSPECIFIED are always installed.
RISE_SERVER_TYPES=SERVER_TYPE_HUB

# --- Server identity --------------------------------------------------------

# Written verbatim to /app/servermeta.json before the server starts.
# Omitted: the entrypoint logs a warning and writes no servermeta.json.
RISE_SERVER_META={"containerName":"hub-0"}

# --- Paths ------------------------------------------------------------------

# The DependSync volume: must contain index.json, hytale/HytaleServer.jar
# and hytale/Assets.zip, or the entrypoint exits before starting the server.
RISE_DEPEND_MOUNT=/dependfiles

# Where mods, worlds, configs and root files are laid out. Must be writable.
RISE_APP_DIR=/app

# --- Runtime ----------------------------------------------------------------

# Bound as 0.0.0.0:$RISE_GAME_PORT.
RISE_GAME_PORT=5520

# Whitespace-separated, passed to java before -jar. Empty by default.
RISE_JVM_FLAGS=

# Backends sit behind the proxy, which authenticates players; the proxy speaks the insecure flow.
RISE_AUTH_MODE=insecure

# Whitespace-separated, passed to HytaleServer.jar after --auth-mode.
RISE_SERVER_FLAGS=--disable-file-watcher
